diff --git a/src/pages/sitemap/index.tsx b/src/pages/sitemap/index.tsx
new file mode 100644
index 0000000..6fff14d
--- /dev/null
+++ b/src/pages/sitemap/index.tsx
@@ -0,0 +1,162 @@
+import React, { useMemo, useState } from "react";
+import Layout from "@theme/Layout";
+import Link from "@docusaurus/Link";
+import "./index.css";
+
+type SitemapLink = {
+  label: string;
+  to: string;
+  description: string;
+  external?: boolean;
+};
+
+type SitemapSection = {
+  title: string;
+  links: SitemapLink[];
+};
+
+const SECTIONS: SitemapSection[] = [
+  {
+    title: "Learn",
+    links: [
+      { label: "Documentation", to: "/docs", description: "Tutorials and guides on SQL, GitHub, Docker, Pandas and more." },
+      { label: "Get Started", to: "/get-started", description: "New here? Begin your recode hive journey." },
+      { label: "Video Courses", to: "/courses", description: "Browse our video course library." },
+      { label: "Explore Courses", to: "/courses/explore", description: "Find a course that fits your goals." },
+      { label: "E-Books", to: "/ebooks", description: "Free downloadable e-books." },
+      { label: "Interview Prep", to: "/interview-prep", description: "Prepare for your next technical interview." },
+      { label: "GitHub Badges", to: "/badges/github-badges", description: "Earn and showcase GitHub badges." },
+    ],
+  },
+  {
+    title: "Community",
+    links: [
+      { label: "Community", to: "/community", description: "Meet the people behind recode hive." },
+      { label: "Our Blog", to: "/blogs", description: "Articles written by the community." },
+      { label: "Broadcasts", to: "/broadcasts", description: "Live sessions and recordings." },
+      { label: "Podcasts", to: "/podcasts", description: "Conversations with developers and creators." },
+      { label: "Showcase", to: "/showcase", description: "Projects built by our community." },
+      { label: "Our Sponsors", to: "/our-sponsors", description: "The people who support our mission." },
+    ],
+  },
+  {
+    title: "Company",
+    links: [
+      { label: "Home", to: "/", description: "Back to the recode hive homepage." },
+      { label: "Careers", to: "/careers", description: "Open roles at recode hive." },
+      { label: "Changelog", to: "/changelog", description: "What's new in recode hive." },
+      { label: "Merch", to: "/merch", description: "Official recode hive merchandise." },
+      { label: "Contact Us", to: "/contact-us", description: "Get in touch with the team." },
+      {
+        label: "Roadmap",
+        to: "https://github.com/orgs/recodehive/projects/9",
+        description: "See what we are building next.",
+        external: true,
+      },
+    ],
+  },
+  {
+    title: "Legal",
+    links: [
+      { label: "Privacy Policy", to: "/privacy-policy", description: "How we handle your data." },
+      { label: "Terms of Service", to: "/terms-service", description: "The rules of using recode hive." },
+      { label: "Code of Conduct", to: "/code-of-conduct", description: "Our community standards." },
+      { label: "License", to: "/License", description: "Open-source license information." },
+    ],
+  },
+  {
+    title: "For Crawlers",
+    links: [
+      { label: "sitemap.xml", to: "/sitemap.xml", description: "Machine-readable sitemap for search engines.", external: true },
+      { label: "RSS Feed", to: "/blog/rss.xml", description: "Subscribe to blog updates via RSS.", external: true },
+    ],
+  },
+];
+
+export default function SitemapPage(): JSX.Element {
+  const [query, setQuery] = useState("");
+
+  const sections = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    if (!q) return SECTIONS;
+    return SECTIONS.map((section) => ({
+      ...section,
+      links: section.links.filter(
+        (l) =>
+          l.label.toLowerCase().includes(q) ||
+          l.to.toLowerCase().includes(q) ||
+          l.description.toLowerCase().includes(q),
+      ),
+    })).filter((section) => section.links.length > 0);
+  }, [query]);
+
+  return (
+    <Layout
+      title="Sitemap"
+      description="Find every page on recode hive in one place."
+    >
+      <div className="sitemap__page">
+        <div className="sitemap__header">
+          <h1>
+            <span className="sitemap__header-brand">&lt;Sitemap/&gt;</span>
+          </h1>
+          <p>Find every page on recode hive in one place.</p>
+          <input
+            type="search"
+            className="sitemap__search"
+            placeholder="Filter pages..."
+            aria-label="Filter pages"
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+          />
+        </div>
+
+        <div className="sitemap__timeline">
+          {sections.length === 0 ? (
+            <p className="sitemap__empty">No pages match your search.</p>
+          ) : (
+            sections.map((section) => (
+              <div className="sitemap__entry" key={section.title}>
+                <span className="sitemap__dot" aria-hidden="true" />
+                <div className="sitemap__card">
+                  <div className="sitemap__card-header">
+                    <span className="sitemap__badge">
+                      <span aria-hidden="true">&gt;_</span> SITEMAP
+                    </span>
+                    <span className="sitemap__count">
+                      {section.links.length}{" "}
+                      {section.links.length === 1 ? "page" : "pages"}
+                    </span>
+                  </div>
+                  <h3 className="sitemap__title">{section.title}</h3>
+                  <ul className="sitemap__list">
+                    {section.links.map((link) => (
+                      <li className="sitemap__item" key={link.to}>
+                        {link.external ? (
+                          <a
+                            href={link.to}
+                            target="_blank"
+                            rel="noopener noreferrer"
+                            className="sitemap__link"
+                          >
+                            {link.label}
+                          </a>
+                        ) : (
+                          <Link to={link.to} className="sitemap__link">
+                            {link.label}
+                          </Link>
+                        )}
+                        <span className="sitemap__path">{link.to}</span>
+                        <p className="sitemap__desc">{link.description}</p>
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              </div>
+            ))
+          )}
+        </div>
+      </div>
+    </Layout>
+  );
+}
